# Server configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./vector_console.db

# Authentication / OIDC (Keycloak integration)
OIDC_ISSUER=http://127.0.0.1:8080/realms/vector-console
OIDC_CLIENT_ID=vector-console-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
SESSION_SECRET=

# Optional Advisory LLM Configuration (opt-in; keys server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
